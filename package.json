{
  "name": "dropbeam",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Friendly desktop file sharing. First development milestone.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "node scripts/dev.mjs --ui-only",
    "dev:cloud": "node scripts/cloud-dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit && tsc -p cloud/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --dir",
    "build:cloud": "node scripts/build-cloud.mjs",
    "dev:all": "node scripts/dev.mjs --with-cloud",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:discovery": "node scripts/smoke-discovery.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
