# Backend only. Copy to cloud/.dev.vars (ignored).
GOOGLE_CLIENT_ID=replace-with-server-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-server-oauth-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-server-oauth-refresh-token
EMAIL_FROM_ADDRESS=replace-with-authorized-gmail-address
# Optional future GIPHY adapter; no credential is needed in this milestone.
